# Copy to .env.local for local development and previews (never commit it).
# In production, set these in the host's environment settings (Vercel).

# Public site origin. Drives canonical URLs, sitemap.xml, robots.txt,
# Open Graph / Twitter tags and the JSON-LD structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.astracoretech.org

# Inquiry database (AstraCore's own; not shared with any other system).
#  - Local/preview: a SQLite file, e.g. file:.data/astracore.db (the default)
#  - Production on Vercel: a hosted libsql database (e.g. Turso) — the
#    filesystem there is not persistent, so a file URL is refused.
DATABASE_URL=file:.data/astracore.db
# Only for hosted libsql databases.
DATABASE_AUTH_TOKEN=

# Founder inbox sign-in (next-auth).
# NEXTAUTH_URL is the public origin; NEXTAUTH_SECRET is a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Time zone used to decide when a next action is overdue.
APP_TIMEZONE=Africa/Nairobi

# Optional search-engine verification. Paste the value from Search Console or
# Bing Webmaster Tools after verifying the production domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
