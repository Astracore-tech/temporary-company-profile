{
    "name": "astracore-portfolio",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "staff:add": "node --env-file-if-exists=.env.local scripts/add-staff.mjs add",
        "staff:remove": "node --env-file-if-exists=.env.local scripts/add-staff.mjs remove",
        "verify:journey": "node scripts/verify-journey.mjs",
        "db:check": "node --env-file-if-exists=.env.local scripts/db-check.mjs",
        "db:check:prod": "node --env-file=.env.prod.local scripts/db-check.mjs",
        "staff:add:prod": "node --env-file=.env.prod.local scripts/add-staff.mjs add"
    },
    "dependencies": {
        "@iconify/react": "^6.0.4",
        "@libsql/client": "^0.18.0",
        "aos": "^2.3.4",
        "next": "^16.4.6",
        "next-auth": "^4.24.15",
        "next-themes": "^0.4.6",
        "nextjs-toploader": "^3.9.17",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@types/aos": "^3.0.8",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22.9"
    }
}
